---
// Gates — the four engineering guarantees (fail-closed core).
import { getLangFromUrl, useTranslations } from "../i18n";

const t = useTranslations(getLangFromUrl(Astro.url));

const gates = [
  {
    n: "1",
    tag: "GRADES",
    accent: "var(--power)",
    icon: '<path d="M4 20h16M7 20v-6h4v6M13 20V8h4v12"/>',
  },
  {
    n: "2",
    tag: "FAIL-CLOSED",
    accent: "var(--alert)",
    icon: '<rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/><path d="M12 15v2"/>',
  },
  {
    n: "3",
    tag: "PER-RECORD SEALS",
    accent: "var(--data)",
    icon: '<path d="M12 2l7 4v6c0 4.5-3 7.5-7 8.5C8 19.5 5 16.5 5 12V6z"/><path d="M9 12l2 2 4-4"/>',
  },
  {
    n: "4",
    tag: "NO AUTO COMMITMENT",
    accent: "var(--warn)",
    icon: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>',
  },
] as const;
---

<section id="gates">
  <div class="shell">
    <span class="stencil">{t("gates.stencil")}</span>
    <h2 class="h-sec">{t("gates.title")}</h2>
    <p class="sub-sec">{t("gates.sub")}</p>

    <div class="gates">
      {gates.map((g) => (
        <article class="panel gate" style={`--accent:${g.accent}`}>
          <div class="panel__bar">
            <span>{g.tag}</span>
            <span class="readout gate__n">G{g.n}</span>
          </div>
          <div class="gate__body">
            <svg class="gate__icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={g.icon} />
            <h3 class="gate__title">{t(`gates.${g.n}.title` as any)}</h3>
            <p class="gate__desc">{t(`gates.${g.n}.body` as any)}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .gates {
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  .gate { overflow: hidden; }
  .gate__n {
    color: var(--accent);
    font-size: 11px;
  }
  .gate__body {
    padding: 26px 24px 28px;
    background: linear-gradient(180deg, var(--steel-850), var(--steel-900));
    border-top: 2px solid var(--accent);
  }
  .gate__icon {
    color: var(--accent);
    margin-bottom: 16px;
  }
  .gate__title {
    font-size: 18px;
    letter-spacing: -0.01em;
  }
  .gate__desc {
    margin-top: 12px;
    font-size: 14px;
    color: var(--ink-dim);
    line-height: 1.7;
  }

  @media (max-width: 860px) {
    .gates { grid-template-columns: 1fr; }
  }
</style>
