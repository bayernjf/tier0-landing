---
// Logo — the Tier 0 mark: the family steel hexagon, with three stacked
// layers inside. The bottom layer (Tier 0, the operating core) is amber;
// the two layers above it are data-cyan, matching the architecture diagram.
const { size = 32 } = Astro.props;
---

<span class="logo" style={`--logo-size: ${size}px`} aria-label="Tier 0" role="img">
  <svg
    width={size}
    height={size}
    viewBox="0 0 32 32"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      d="M16 2.2 28.1 8.5v13L16 29.8 3.9 21.5v-13z"
      fill="var(--steel-800)"
      stroke="var(--steel-400)"
      stroke-width="1.6"
      stroke-linejoin="round"
    />
    <path
      d="M16 7.1 23.5 11v8L16 22.9 8.5 19v-8z"
      fill="none"
      stroke="var(--data)"
      stroke-width="1"
      opacity=".5"
    />
    <g>
      <!-- upper layers (applications / platform) -->
      <rect x="12" y="10.8" width="8" height="1.9" rx=".3" fill="var(--data)" opacity=".45" />
      <rect x="10.2" y="14" width="11.6" height="1.9" rx=".3" fill="var(--data)" opacity=".75" />
      <!-- Tier 0 base layer — the operating core -->
      <rect x="8.4" y="17.3" width="15.2" height="2.3" rx=".4" fill="var(--power)" />
      <rect x="8.4" y="17.3" width="15.2" height="2.3" rx=".4" fill="none" stroke="var(--power)" stroke-width=".5" opacity=".6" />
    </g>
  </svg>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--logo-size, 32px);
    height: var(--logo-size, 32px);
    flex: none;
  }
  .logo svg {
    display: block;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 10px rgba(255, 176, 32, 0.12));
  }
</style>
