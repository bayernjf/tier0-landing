---
// Modules — zeus runs as a full-width cross-cutting kernel strip (the kernel
// is shared by every module), then six module cards below.
import { getLangFromUrl, useTranslations } from "../i18n";

const t = useTranslations(getLangFromUrl(Astro.url));

const cards = [
  {
    id: "commerce",
    chips: ["74 cases", "sandbox-douyin", "payment · fulfillment 501"],
    tone: "ok",
  },
  {
    id: "loom",
    chips: ["1,481 tests", "model output → review → listing"],
    tone: "data",
  },
  {
    id: "job",
    chips: ["1,862 tests", "kernel wiring scheduled"],
    tone: "faint",
  },
  {
    id: "world",
    chips: ["2,030 tests", "executor wiring in M7"],
    tone: "faint",
  },
  {
    id: "atlas",
    chips: ["3,900+ tests", "executor wiring in M7"],
    tone: "faint",
  },
  {
    id: "dev",
    chips: ["535 tests", "M5 self-bootstrap"],
    tone: "faint",
  },
];
---

<section id="modules">
  <div class="shell">
    <span class="stencil">{t("modules.stencil")}</span>
    <h2 class="h-sec">{t("modules.title")}</h2>
    <p class="sub-sec">{t("modules.sub")}</p>

    <!-- zeus: the cross-cutting kernel -->
    <article class="kernel panel panel--riveted">
      <div class="panel__bar">
        <span>{t("modules.zeus.tag")}</span>
        <span class="kernel__bar-status">
          <span class="led" data-c="power" />
          {t("modules.zeus.status")}
        </span>
      </div>
      <div class="kernel__body">
        <div class="kernel__copy">
          <h3 class="kernel__name">zeus</h3>
          <p class="kernel__text">{t("modules.zeus.body")}</p>
        </div>
        <ul class="kernel__chips">
          <li>2,227 tests</li>
          <li>D0–D3 HTTP API v1</li>
          <li>Ed25519 seal chain</li>
          <li>replay &amp; repair</li>
          <li class="kernel__chips-note">{t("modules.zeus.statusSub")}</li>
        </ul>
      </div>
    </article>

    <!-- the six modules around the kernel -->
    <div class="cards">
      {cards.map((c) => (
        <article class={`card card--${c.tone}`}>
          <div class="card__head">
            <span class="card__tag">{t(`modules.card.${c.id}.tag` as any)}</span>
            <span class="card__status">{t(`modules.card.${c.id}.status` as any)}</span>
          </div>
          <h3 class="card__name">{t(`modules.card.${c.id}.name` as any)}</h3>
          <p class="card__body">{t(`modules.card.${c.id}.body` as any)}</p>
          <ul class="card__chips">
            {c.chips.map((chip) => <li>{chip}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <p class="modules__footnote">{t("modules.footnote")}</p>
  </div>
</section>

<style>
  .kernel {
    margin: 44px 0 0;
    overflow: hidden;
    border-color: var(--power-dim);
  }
  .kernel__bar-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--power);
  }
  .kernel__body {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 32px;
    padding: 26px 28px 24px;
  }
  .kernel__name {
    font-family: var(--mono);
    font-size: 26px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--power);
  }
  .kernel__text {
    margin-top: 12px;
    max-width: 56ch;
    font-size: 14px;
    line-height: 1.7;
    color: var(--ink-dim);
  }
  .kernel__chips {
    align-self: center;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .kernel__chips li {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--ink);
    padding: 8px 12px;
    border: 1px solid var(--steel-600);
    background: var(--steel-950);
    border-left: 2px solid var(--power);
  }
  .kernel__chips-note {
    border-left-color: var(--steel-600) !important;
    color: var(--ink-faint) !important;
    font-size: 11px !important;
  }

  .cards {
    margin: 18px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 20px 20px 22px;
    background: linear-gradient(180deg, var(--steel-800), var(--steel-850));
    border: 1px solid var(--steel-600);
    box-shadow: var(--bevel);
  }
  .card--ok { border-top: 2px solid var(--ok); }
  .card--data { border-top: 2px solid var(--data); }
  .card--faint { border-top: 2px solid var(--steel-500); }
  .card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .card__tag {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    color: var(--data);
  }
  .card--faint .card__tag { color: var(--ink-faint); }
  .card--ok .card__tag { color: var(--ok); }
  .card__status {
    flex: none;
    font-family: var(--mono);
    font-size: 8.5px;
    letter-spacing: 0.08em;
    padding: 3px 7px;
    border: 1px solid var(--steel-500);
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .card--ok .card__status {
    color: var(--ok);
    border-color: var(--ok);
    box-shadow: 0 0 12px -4px var(--ok);
  }
  .card--data .card__status {
    color: var(--data);
    border-color: var(--data);
    box-shadow: 0 0 12px -4px var(--data);
  }
  .card__name {
    margin-top: 13px;
    font-size: 18px;
  }
  .card__body {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-dim);
    flex: 1;
  }
  .card__chips {
    margin: 14px 0 0;
    padding: 13px 0 0;
    border-top: 1px dashed var(--steel-600);
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .card__chips li {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.03em;
    color: var(--ink-faint);
    padding: 3px 8px;
    background: var(--steel-900);
    border: 1px solid var(--steel-700);
  }

  .modules__footnote {
    margin: 22px 0 0;
    font-family: var(--mono);
    font-size: 10.5px;
    line-height: 1.7;
    color: var(--ink-faint);
  }

  @media (max-width: 980px) {
    .kernel__body { grid-template-columns: 1fr; gap: 20px; }
    .cards { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .cards { grid-template-columns: 1fr; }
    .kernel__body { padding: 20px 18px 18px; }
  }
</style>
