---
import Layout from "../layouts/Layout.astro";
import Hud from "../components/Hud.astro";
import Footer from "../components/Footer.astro";
import { SITE_NAME } from "../consts";

const title = `404: Module Not Found | ${SITE_NAME}`;
---

<Layout title={title}>
  <Hud />
  <main class="lost">
    <div class="shell">
      <div class="panel panel--riveted lost__panel">
        <div class="panel__bar">
          <span>family map · 404</span>
          <span class="led" data-c="alert"></span>
        </div>
        <div class="lost__body">
          <p class="eyebrow">unregistered module</p>
          <h1 class="h-sec">This module is not on the family map</h1>
          <p class="sub-sec">
            No module is mapped to the address you requested. Head back to the
            product family console and pick a layer.
          </p>
          <a class="btn" href="/">Back to console</a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .lost {
    display: flex;
    align-items: center;
    min-height: 100vh;
    padding: 120px 0 96px;
  }
  .lost__panel {
    max-width: 620px;
  }
  .lost__body {
    padding: 32px 28px 34px;
  }
  .lost__body .btn {
    margin-top: 28px;
  }
</style>
