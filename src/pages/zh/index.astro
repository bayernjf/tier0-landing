---
// Same composition as the root page; every component reads its locale from
// Astro.url, so the only difference between the two routes is the prefix.
import Layout from "../../layouts/Layout.astro";
import Hud from "../../components/Hud.astro";
import Hero from "../../components/Hero.astro";
import Principles from "../../components/Principles.astro";
import Modules from "../../components/Modules.astro";
import Gates from "../../components/Gates.astro";
import Roadmap from "../../components/Roadmap.astro";
import Cta from "../../components/Cta.astro";
import Footer from "../../components/Footer.astro";
---

<Layout>
  <Hud />
  <main>
    <Hero />
    <div data-reveal><Principles /></div>
    <div data-reveal><Modules /></div>
    <div data-reveal><Gates /></div>
    <div data-reveal><Roadmap /></div>
    <div data-reveal><Cta /></div>
  </main>
  <Footer />
</Layout>
